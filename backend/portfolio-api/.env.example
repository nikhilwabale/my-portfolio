# Copy to .env for local reference and export these into your shell / IDE run config.
# Spring Boot does not auto-load .env files - these are plain OS environment variables,
# same as the old backend. See README.md for how to run locally.

SPRING_PROFILES_ACTIVE=dev

# Neon PostgreSQL connection string (postgres:// URI form, exactly as Neon gives it to you)
DATABASE_URL=postgres://USER:PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require

# CORS - comma separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://my-portfolio-lake-one.vercel.app

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_TO_EMAIL=wablenikhil2000@gmail.com
