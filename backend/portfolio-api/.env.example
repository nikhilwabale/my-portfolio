# Copy to .env and fill in the real values. springboot4-dotenv (see pom.xml) loads .env
# automatically on startup - no manual export needed. See README.md for how to run locally.

SPRING_PROFILES_ACTIVE=dev

# Neon PostgreSQL connection string (postgres:// URI form, exactly as Neon gives it to you)
DATABASE_URL=postgres://USER:PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require

# CORS - comma separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://my-portfolio-lake-one.vercel.app

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: enforce Turnstile locally too (normally bypassed when SPRING_PROFILES_ACTIVE=dev)
# SECURITY_ENABLE_TURNSTILE_IN_DEVELOPMENT=true

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_TO_EMAIL=wablenikhil2000@gmail.com
